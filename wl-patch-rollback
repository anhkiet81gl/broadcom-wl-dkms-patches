#!/usr/bin/env bash
# Puts back the unpatched wl driver and source for the running kernel, then reloads Wi-Fi.
set -euo pipefail
kernel=$(uname -r)
backup_dir=/var/lib/wl-patch
original_module="$backup_dir/wl-$kernel-original.ko.zst"
original_source="$backup_dir/wl_cfg80211_hybrid.c.original"

for backup_path in "$backup_dir" "$original_module" "$original_source"; do
    if [ -L "$backup_path" ] || [ "$(stat -c %u "$backup_path")" != 0 ] || [ -n "$(find "$backup_path" -maxdepth 0 -perm /022)" ]; then
        echo "refusing: $backup_path is a symlink, not owned by root, or writable by others" >&2
        exit 1
    fi
done
(cd "$backup_dir" && sha256sum --check --quiet SHA256SUMS)

install -m 644 "$original_module" "/lib/modules/$kernel/updates/dkms/wl.ko.zst"
install -m 644 "$original_source" /usr/src/broadcom-wl-6.30.223.271/src/wl/sys/wl_cfg80211_hybrid.c
depmod "$kernel"
modprobe -r wl
modprobe wl
systemctl restart wpa_supplicant.service NetworkManager.service
logger -t wl-patch "rolled back to the original wl driver"
